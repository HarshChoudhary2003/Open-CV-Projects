# ════════════════════════════════════════════════════
# VisionAI Platform — Environment Configuration
# Copy this to .env and fill in your values
# ════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────
APP_NAME="VisionAI Platform"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# ── Security ─────────────────────────────────────────
# IMPORTANT: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-me-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── CORS ─────────────────────────────────────────────
ALLOWED_ORIGINS=["*"]

# ── Database ─────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./visionai.db

# ── Stream Settings ───────────────────────────────────
DEFAULT_CAMERA_INDEX=0
STREAM_FPS=30
STREAM_WIDTH=1280
STREAM_HEIGHT=720
JPEG_QUALITY=85

# ── AI Models ────────────────────────────────────────
YOLO_MODEL=yolov8n.pt         # yolov8n | yolov8s | yolov8m | yolov8l | yolov8x
YOLO_CONFIDENCE=0.45
YOLO_IOU=0.45
POSE_MODEL=mediapipe
OCR_ENGINE=easyocr

# ── GPU ──────────────────────────────────────────────
USE_GPU=true
DEVICE=auto                   # auto | cpu | cuda | mps

# ── Anomaly ──────────────────────────────────────────
ANOMALY_SENSITIVITY=0.75
ALERT_COOLDOWN_SECONDS=10

# ── Directories ──────────────────────────────────────
SNAPSHOT_DIR=snapshots
LOG_DIR=logs
REPORT_DIR=reports

# ── LLM (optional AI reasoning) ──────────────────────
LLM_PROVIDER=none             # none | openai | ollama
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# ── Email Alerts (optional) ───────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_app_password
# ALERT_EMAIL_TO=alerts@yourcompany.com
